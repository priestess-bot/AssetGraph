APP_NAME=AssetGraph
APP_ENV=local
API_PREFIX=/api

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assetgraph
POSTGRES_USER=assetgraph
POSTGRES_PASSWORD=assetgraph

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=assetgraph
MINIO_SECRET_KEY=assetgraph-secret
MINIO_BUCKET=assetgraph

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=assetgraph-password

MILVUS_HOST=localhost
MILVUS_PORT=19530

QWEN3_BASE_URL=http://127.0.0.1:8010
QWEN3_API_KEY=local-no-auth
QWEN3_EMBEDDING_MODEL=qwen3-embedding-4b-local
QWEN3_RERANK_MODEL=qwen3-reranker-4b-local
QWEN3_EMBEDDING_DIMENSIONS=1024
QWEN3_TIMEOUT_SECONDS=120

# Online generation and multimodal analysis. Keep real keys outside git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_BULK_MODEL=gpt-5.6-terra
OPENAI_IMAGE_REVIEW_MODEL=gpt-5.6-sol
OPENAI_VIDEO_FRAME_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
ONLINE_MODEL_TIMEOUT_SECONDS=180
ONLINE_MODEL_MAX_ATTEMPTS=3

ASSETGRAPH_MAITU_MIRROR_ROOT=/DATA/Downloads/AssetGraph/maitu-mirror
ASSETGRAPH_MATERIAL_ANALYSIS_ROOT=/DATA/Downloads/AssetGraph/material-analysis
ASSETGRAPH_LIVE_RESEARCH_ROOT=/DATA/Downloads/AssetGraph/live-research
ASSETGRAPH_STREAMCAP_CHECKOUT=.external/StreamCap
ASSETGRAPH_STREAMCAP_PYTHON=.external/streamcap-venv/bin/python
ASSETGRAPH_DOUYINLIVE_BINARY=.external/bin/douyinLive

# Theme-driven video production outputs and single-worker lease timing.
ASSETGRAPH_VIDEO_PRODUCTION_ROOT=/DATA/Downloads/AssetGraph/video-productions
ASSETGRAPH_VIDEO_PRODUCTION_WORKER_LEASE_SECONDS=300
ASSETGRAPH_VIDEO_PRODUCTION_WORKER_HEARTBEAT_SECONDS=30
ASSETGRAPH_VIDEO_PRODUCTION_WORKER_POLL_SECONDS=1
ASSETGRAPH_TTS_BASE_URL=http://127.0.0.1:8020
# ASSETGRAPH_KOKORO_MODEL_ROOT=/absolute/path/to/kokoro-model-cache

# Optional external roots. Leave blank to use repository-relative defaults.
# ASSETGRAPH_ASSETS_ROOT=/absolute/path/to/assets
# BROWSER_USE_REPO=/absolute/path/to/browser-use
# QWEN3_MODELS_ROOT=/absolute/path/to/qwen3-4b

# Visible Chrome session used for real Maitu observation and draft-only execution.
BROWSER_USE_CDP_URL=http://127.0.0.1:9223
BROWSER_USE_SESSION_NAME=assetgraph-maitu-vnc

# Phase D fenced script-layout execution. Generate independent random values
# of at least 32 characters; never reuse the Worker bearer as the readback key.
ASSETGRAPH_SCRIPT_LAYOUT_WORKER_TOKEN=
ASSETGRAPH_SCRIPT_LAYOUT_WORKER_ID=assetgraph-browser-use-worker
ASSETGRAPH_MAITU_RECONCILIATION_OPERATOR_TOKEN=
ASSETGRAPH_MAITU_RECONCILIATION_OPERATOR_ID=configured-maitu-operator
# Backend process only: never expose either value to the Browser-use Worker.
ASSETGRAPH_MAITU_AUTHORITY_TOKEN=
ASSETGRAPH_MAITU_READBACK_ATTESTATION_KEY=
ASSETGRAPH_MAITU_AUTHORITY_BASE_URL=https://api.maituai.com
ASSETGRAPH_MAITU_AUTHORITY_TIMEOUT_SECONDS=30
